{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // **و`vite/client` معها لا وحدَها.** `types` تُلغي ما ورثه التصريفُ
    // الأصليّ، فاختبارٌ يستورد خدمةً من `src/` يجرّ معه `src/lib/supabase.ts`
    // وفيه `import.meta.env` — فيسقط البناءُ بـ«‏Property 'env' does not
    // exist‏»، وهو عيبٌ في الإعداد يُقرأ عيباً في الشيفرة.
    "types": [
      "vitest/globals",
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "test",
    "vitest.config.ts"
  ]
}
