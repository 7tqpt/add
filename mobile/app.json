{
  "expo": {
    "name": "أعراس اليمن",
    "slug": "aras-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aras",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8f4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ye.aras.app"
    },
    "android": {
      "package": "ye.aras.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#faf8f4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {}
    }
  }
}
