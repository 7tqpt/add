<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- نافذةُ الإقلاع — من ضغط الأيقونة إلى أوّل إطارٍ يرسمه Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- ما خلف واجهة Flutter بعد أن يقلع المحرّك.

         **وهي نبيذيّةٌ لا كريميّة، وهذا تبديلٌ مقصود.** كانت كريماً
         (`brand_page`) فكان التسلسلُ: نافذةُ الإقلاع، ثمّ كريمٌ لحظةً، ثمّ
         `BootScreen` النبيذيّة — أي ومضةٌ فاتحةٌ بين نبيذيَّين. وأوّلُ ما
         يرسمه التطبيقُ نبيذيٌّ دائماً، فالنبيذيُّ هنا يجعل السلسلةَ لوناً
         واحداً من الضغطة إلى أوّل إطار. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_splash</item>
    </style>
</resources>
