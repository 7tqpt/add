# انسخ هذا الملف إلى .env واملأه من Supabase ← Project Settings ← API
# EXPO_PUBLIC_ يجعل المتغيّر متاحاً داخل التطبيق — وهذا مقصود: المفتاح
# publishable مصمَّم للعمل في الأجهزة، وRLS هي ما يحمي البيانات لا سرّيته.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
